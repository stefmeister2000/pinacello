# Zet deze waarden als environment variables op Railway (NIET in de code committen).
# Maak een NIEUWE key aan in Resend (de oude is gedeeld en dus onveilig).

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optioneel — enkel als je een welkomstmail met de code wil sturen.
# Vereist een GEVERIFIEERD domein in Resend (bv. hallo@pinacello.com).
# RESEND_FROM=Pinacello <hallo@pinacello.com>
