# Zet deze op Railway → Variables (NIET in de code committen).
# Maak eerst een NIEUWE key aan in Resend (de oude is gedeeld en dus onveilig).

# VERPLICHT — de enige die je echt nodig hebt:
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# OPTIONEEL — de server maakt zelf een lijst "Pinacello nieuwsbrief" aan.
# Zet dit enkel als je een bestaande lijst wil gebruiken:
# RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# RESEND_AUDIENCE_NAME=Pinacello nieuwsbrief

# OPTIONEEL — welkomstmail met de kortingscode.
# Vereist een GEVERIFIEERD domein in Resend (bv. hallo@pinacello.com).
# RESEND_FROM=Pinacello <hallo@pinacello.com>
