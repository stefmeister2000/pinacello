# Zet deze op Railway → Variables (NIET in de code committen).
# Maak eerst een NIEUWE key aan in Mailchimp (de oude is gedeeld en dus onveilig).

# VERPLICHT — het datacenter (bv. -us16) zit achteraan in de key:
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-usXX

# OPTIONEEL — anders gebruikt de server automatisch je eerste audience.
# MAILCHIMP_AUDIENCE_ID=7cca314aef
